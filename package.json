    "cv:pdf:game-en": "node --import tsx tools/generate-cv.tsx --role GameDev --locale en",
    "cv:pdf:game-es": "node --import tsx tools/generate-cv.tsx --role GameDev --locale es",
    "cv:pdf:backend-en": "node --import tsx tools/generate-cv.tsx --role Backend --locale en",
    "cv:pdf:web-en": "node --import tsx tools/generate-cv.tsx --role WebDev --locale en"
  },
