    "next": "^16",
    "next-intl": "^4",
    "react": "^19",
    "react-dom": "^19",
    "react-icons": "^5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@mdx-js/loader": "^3",
    "@next/mdx": "^16",
    "@react-pdf/renderer": "4",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7",
    "@testing-library/react": "^16",
    "@types/jsdom": "^30",
    "@types/lodash": "^4",
    "@types/mdx": "^2",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8",
    "@vitejs/plugin-react": "^6",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "^10",
    "eslint-config-next": "^16",
    "esrun": "^3",
    "gray-matter": "^4",
    "gts": "^7",
    "jsdom": "^30",
    "remark": "^15",
    "remark-gfm": "^4",
    "remark-html": "^16",
    "serve": "^14",
    "tailwindcss": "^4",
    "tsx": "^4",
    "typescript": "^7",
    "vite": "^8.3.5",
    "vite-tsconfig-paths": "^6",
    "vitest": "^5"
