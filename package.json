    "clsx": "^2",
    "eslint-plugin-n": "^17",
    "esrun": "^3",
    "flowbite-react": "^0",
    "gray-matter": "^4",
    "lodash": "^4",
    "motion": "^12",
    "next": "^16",
    "next-intl": "^4",
    "react": "^19",
    "react-dom": "^19",
    "react-icons": "^5",
