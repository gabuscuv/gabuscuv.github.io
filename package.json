  "private": true,
  "engines": {
    "node": ">=23.0.0"
  },
  "scripts": {
    "dev": "next dev --experimental-https",
    "prebuild": "yarn lint && yarn typecheck",
    "build": "next build",
    "start": "npx serve out",
    "lint": "gts lint",
    "clean": "gts clean",
    "typecheck": "tsc --noEmit",
